HTTP_PORT=9090

# IP или подсеть вашего реверс-прокси (перед этим контейнером) — для nginx real_ip,
# чтобы в логах был реальный IP клиента, а не адрес прокси.
# Можно один IP (1.2.3.4) или подсеть (1.2.3.0/24).
TRUSTED_PROXY_IP=

WEBHOOK_SITE=https://webhook.domain.com/
WEBHOOK_APP=https://webhook.domain.com/
WEBHOOK_SCHEDULE_GET=https://webhook.domain.com/webhook/schedule
WEBHOOK_SCHEDULE_SET=https://webhook.domain.com/webhook/schedule

# Секрет для заголовка X-Admin-Token, которым /admin подтверждает себя n8n при сохранении расписания.
# Сгенерируйте длинный случайный токен, не оставляйте CHANGE_ME.
ADMIN_TOKEN=CHANGE_ME
